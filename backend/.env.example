DATABASE_URL=postgresql+psycopg://taskeval:taskeval@localhost:5433/taskeval
CORS_ORIGINS=["http://localhost:8080", "http://localhost:5173"]

# One of: anthropic | openai | gemini | groq | fireworks
# The LLM judges (Sufficiency, Review Report) use LLM_PROVIDER / LLM_MODEL; the agent's
# model is AGENT_MODEL below. gpt-6-sol matched gpt-6-astra on our checks (it caught a task with a
# missing requirement) at one fifth of the price; gpt-6-luna is ~100x cheaper but missed one.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-sol
# Cheaper judge alternative on Google (needs GEMINI_API_KEY): it matched gpt-6-sol on Sufficiency in
# our check at about a third of the cost. Use a PAID-tier key: on Google's free tier, prompts (which
# include hidden tests and reference solutions) may be used to improve Google's products.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite
LLM_RPM=60
# Tokens per minute cap for judge calls. Leave commented out for no cap (an empty value fails to parse).
# LLM_TPM=

# Only the key matching LLM_PROVIDER above needs a real value.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=

# Terminal-Bench's own optional AI-detection check (calls the real GPTZero
# API). Empty = that check just no-ops (prints a warning, passes) instead
# of erroring -- see vendor/tb_checks/PROVENANCE.md.
GPTZERO_API_KEY=

# Days before the vendored Terminal-Bench checks and rubric show a reminder to run
# scripts/diff_vendored_checks.py. 0 turns the reminder off.
VENDOR_STALE_DAYS=30
# Seconds each vendored TB check may run. A check that runs out of time shows as not run.
TB_CHECK_TIMEOUT_SEC=180

# Architecture for all builds and container runs (linux/arm64 or linux/amd64).
# amd64 works on Apple Silicon too, but emulated and much slower.
DOCKER_PLATFORM=linux/arm64

# Oracle, Nop and Agent Trials run through the Harbor CLI (install: uv tool install harbor==0.26.0, the
# version the platform was tested with; 0.25.0 also runs them and is the first with Reward Kit's Worker).
HARBOR_BIN=harbor
# Only needed when HARBOR_BIN is Harbor 0.25.x: its `harbor analyze` and `harbor check` (Failure Analysis,
# the Cheat Trial's reward-hacking check, Rubric Check) fail with DownloadVerifierDirError, fixed in 0.26.0.
# Then install 0.26.0 apart from the main one, for example:
#   UV_TOOL_DIR=$PWD/storage/harbor-0.26/tools UV_TOOL_BIN_DIR=$PWD/storage/harbor-0.26/bin uv tool install harbor==0.26.0
# and set HARBOR_ANALYZE_BIN=<backend>/storage/harbor-0.26/bin/harbor. Empty (the default) = use HARBOR_BIN for everything.
HARBOR_ANALYZE_BIN=
# Pin addresses into every Docker build (hostname:ip, comma-separated). Only for networks that
# filter one address of a multi-address host, e.g. GitHub's release/raw CDN where 185.199.109.133
# hangs: a Dockerfile that downloads from GitHub then fails at random. Empty = normal DNS.
# DOCKER_ADD_HOSTS=raw.githubusercontent.com:185.199.108.133,release-assets.githubusercontent.com:185.199.108.133
# Network policy every task is run with (a temporary copy; extracted files are not edited).
# Empty = respect each task's own allow_internet / network_mode.
HARBOR_NETWORK_MODE=public

# Agent trials. AGENT_MODEL is a LiteLLM model string (e.g. openai/gpt-6-astra);
# leave empty to use LLM_PROVIDER/LLM_MODEL. LLM_MAX_ITERS caps the agent's turns.
HARBOR_AGENT=terminus-2
AGENT_MODEL=
AGENT_REASONING_EFFORT=
AGENT_TRIALS_CONCURRENCY=1
# Claude Code agent (the UI's "Claude Code · Fable 5.1" choice, or HARBOR_AGENT=claude-code). Needs
# ANTHROPIC_API_KEY; like Codex it installs itself and runs inside the task container, so the key
# enters the container and it needs HARBOR_NETWORK_MODE=public. Each trial also gets its share of
# the run cost cap as Claude Code's own --max-budget-usd, since its cost can't be read mid-run.
CLAUDE_AGENT_MODEL=anthropic/claude-fable-5-1
# Agent timeout in seconds forced on every task (Terminal-Bench 4.0 uses a flat 8 hours = 28800).
# Empty/0 = each task.toml's own [agent] timeout_sec.
AGENT_TIMEOUT_SEC=28800
# Seconds a single model request may take inside Harbor's Terminus-2 (LiteLLM's own default is 600).
LITELLM_REQUEST_TIMEOUT_SEC=3600
# Warn when the run cost cap divided by the trial count is below this many USD (observed trials cost $3 to $42).
MIN_TRIAL_COST_USD=3
# Results review: below this many scored agent trials the page gives counts and a 95% interval, not a pass rate.
MIN_TRIALS_FOR_RATE=5
# Stops an agent-trials run once its own cost (finished + in-flight trials) reaches this many
# USD. Also capped by what is left of LLM_BUDGET_USD this month. 0 disables it.
AGENT_RUN_BUDGET_USD=5
# To use the Codex agent instead of Terminus-2 (needs an openai/* AGENT_MODEL, an OPENAI_API_KEY,
# and HARBOR_NETWORK_MODE=public, since Codex installs itself and calls OpenAI from inside the
# task container): HARBOR_AGENT=codex. Codex has no turn cap and ignores LLM_MAX_ITERS.
# CODEX_VERSION pins the Codex CLI (empty = latest on every trial); CODEX_WEB_SEARCH is
# disabled | cached | live (empty = Codex default).
# CODEX_BAKE_INTO_IMAGE=true installs Codex while the task image builds, so trials don't
# download it from GitHub/npm/apt (set false to let Harbor install it at trial time).
CODEX_BAKE_INTO_IMAGE=true
CODEX_VERSION=
CODEX_WEB_SEARCH=
# true switches off the agents' built-in web tools (Claude Code WebSearch/WebFetch, Codex web_search).
# Off by default, as in Terminal-Bench; what agents did with the web is counted and shown in the evidence.
# It does not stop `curl` in the container: tasks run on the public network only. An explicit
# CODEX_WEB_SEARCH overrides this for Codex.
AGENT_DISABLE_WEB_SEARCH=false
# Failure analysis (the "Analyze Trials" button = `harbor analyze` over the agent trials). A cheap
# evaluator model reads each trajectory and checks reward hacking and task specification. Terminus-2
# runs on this machine, so the OpenAI key stays out of the container. Needs OPENAI_API_KEY.
ANALYZE_AGENT=terminus-2
ANALYZE_MODEL=openai/gpt-6-luna
ANALYZE_TIMEOUT_SEC=3600
# Each trial is analysed on its own (two at a time); one hung evaluator costs this long, not the whole run.
ANALYZE_TRIAL_TIMEOUT_SEC=900
# Rubric check (the "Run Rubric Check" button = `harbor check` over the whole task, not the agent
# trials -- an automated stand-in for a human task reviewer). Runs Claude Code, so it needs
# ANTHROPIC_API_KEY. A task with a very large environment/ (e.g. vendored dependencies) can hit an
# OS argument-length limit in Harbor's own launcher; that shows up as an error in the stage's logs.
CHECK_AGENT=claude-code
CHECK_MODEL=anthropic/claude-fable-5-1
CHECK_TIMEOUT_SEC=3600
# Evaluator agent's own limit inside harbor check (Harbor's built-in value is 1800)
CHECK_AGENT_TIMEOUT_SEC=3300
# Cheat trial (the "Run Cheat Trial" button): one trial run with an explicit directive to cheat
# spliced into the instruction, to confirm the anti-cheat design holds when the agent is told to
# cheat, not just when it happens to behave. Uses the same agent/model as a normal trial.
CHEAT_TRIAL_TIMEOUT_SEC=3600
# Monthly (UTC calendar month) spending cap for all priced LLM use (agent trials and
# OpenAI judge calls), in USD; 0 disables it.
LLM_BUDGET_USD=50

# Grader Isolation gate (does agent-written code run in the verifier without a Reward Kit Worker?).
# false = advisory: recorded and shown, nothing waits. true = agent trials, the cheat trial, Tier 1/2,
# the tier cycle and evidence sets are refused (409) until it passes or a reviewer rules on it.
GRADER_ISOLATION_ENFORCE=false
LLM_MAX_ITERS=30

# Judge calls (Sufficiency, Review Report) use LLM_PROVIDER/LLM_MODEL. For the real
# OpenAI API these two apply (the output cap includes reasoning tokens; 0 = no cap, which is
# the default, because a cap cut the edge-case probe's answer to nothing). Ignored otherwise.
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=0

# How much of a task's files the Sufficiency judge reads (characters). Long documents
# are cut at the per-file limit (the file is still listed as cut), so raise these for tasks with
# big dossiers; defaults are 150000 per file and 500000 in total.
# JUDGE_MAX_FILE_CHARS=150000
# JUDGE_MAX_TOTAL_CHARS=500000

# Tier 1 (hinted agent + hardening loop). Sonnet 4.5 for the testing phase (retires 2026-11-30). The hacker is the Claude Code agent (anthropic/ prefix).
TIER1_HACKER_MODEL=anthropic/claude-haiku-5-5
TIER1_JUDGE_MODEL=claude-haiku-5-5
TIER1_FIXER_MODEL=claude-haiku-5-5
TIER1_REASONING_EFFORT=medium
TIER1_ATTEMPT_TIMEOUT_SEC=1800
TIER1_ATTEMPT_COST_USD=1.0
TIER1_MAX_COST_USD=10

# Tier 2 (unhinted agent): no verifier access, no cheat charter, independent runs. Sonnet 4.5 rejects
# the effort parameter, so the platform leaves it out for that model whatever is set here.
TIER2_HACKER_MODEL=anthropic/claude-haiku-5-5
TIER2_JUDGE_MODEL=claude-haiku-5-5
TIER2_REASONING_EFFORT=medium
TIER2_ATTEMPT_TIMEOUT_SEC=1800
TIER2_ATTEMPT_COST_USD=2.0
TIER2_MAX_COST_USD=10
