DATABASE_URL=postgresql+psycopg://taskeval:taskeval@localhost:5433/taskeval
CORS_ORIGINS=["http://localhost:8080", "http://localhost:5173"]

# One of: anthropic | openai | gemini | groq | fireworks
# The LLM judges (Sufficiency, Code Smell, Review Report) use LLM_PROVIDER / LLM_MODEL; the agent's
# model is AGENT_MODEL below. gpt-6-sol matched gpt-6-astra on our checks (it caught a task with a
# missing requirement) at one fifth of the price; gpt-6-luna is ~100x cheaper but missed one.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-sol
# Cheaper judge alternative on Google (needs GEMINI_API_KEY): it matched gpt-6-sol on Sufficiency in
# our check at about a third of the cost. Use a PAID-tier key: on Google's free tier, prompts (which
# include hidden tests and reference solutions) may be used to improve Google's products.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite
LLM_RPM=60
LLM_TPM=

# Only the key matching LLM_PROVIDER above needs a real value.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=

# Architecture for all builds and container runs (linux/arm64 or linux/amd64).
# amd64 works on Apple Silicon too, but emulated and much slower.
DOCKER_PLATFORM=linux/arm64

# Oracle, Nop and Agent Trials run through the Harbor CLI (install: uv tool install harbor).
HARBOR_BIN=harbor
# Pin addresses into every Docker build (hostname:ip, comma-separated). Only for networks that
# filter one address of a multi-address host, e.g. GitHub's release/raw CDN where 185.199.109.133
# hangs: a Dockerfile that downloads from GitHub then fails at random. Empty = normal DNS.
# DOCKER_ADD_HOSTS=raw.githubusercontent.com:185.199.108.133,release-assets.githubusercontent.com:185.199.108.133
# Network policy every task is run with (a temporary copy; extracted files are not edited).
# Empty = respect each task's own allow_internet / network_mode.
HARBOR_NETWORK_MODE=public

# Agent trials. AGENT_MODEL is a LiteLLM model string (e.g. openai/gpt-6-astra);
# leave empty to use LLM_PROVIDER/LLM_MODEL. LLM_MAX_ITERS caps the agent's turns.
HARBOR_AGENT=terminus-2
AGENT_MODEL=
AGENT_REASONING_EFFORT=
AGENT_TRIALS_CONCURRENCY=1
# Agent timeout in seconds forced on every task (Terminal-Bench 4.0 uses a flat 8 hours = 28800).
# Empty/0 = each task.toml's own [agent] timeout_sec.
AGENT_TIMEOUT_SEC=
# Stops an agent-trials run once its own cost (finished + in-flight trials) reaches this many
# USD. Also capped by what is left of LLM_BUDGET_USD this month. 0 disables it.
AGENT_RUN_BUDGET_USD=5
# To use the Codex agent instead of Terminus-2 (needs an openai/* AGENT_MODEL, an OPENAI_API_KEY,
# and HARBOR_NETWORK_MODE=public, since Codex installs itself and calls OpenAI from inside the
# task container): HARBOR_AGENT=codex. Codex has no turn cap and ignores LLM_MAX_ITERS.
# CODEX_VERSION pins the Codex CLI (empty = latest on every trial); CODEX_WEB_SEARCH is
# disabled | cached | live (empty = Codex default).
# CODEX_BAKE_INTO_IMAGE=true installs Codex while the task image builds, so trials don't
# download it from GitHub/npm/apt (set false to let Harbor install it at trial time).
CODEX_BAKE_INTO_IMAGE=true
CODEX_VERSION=
CODEX_WEB_SEARCH=
# Failure analysis (the "Analyze Trials" button = `harbor analyze` over the agent trials). A cheap
# evaluator model reads each trajectory and checks reward hacking and task specification. Terminus-2
# runs on this machine, so the OpenAI key stays out of the container. Needs OPENAI_API_KEY.
ANALYZE_AGENT=terminus-2
ANALYZE_MODEL=openai/gpt-6-luna
ANALYZE_TIMEOUT_SEC=3600
# Monthly (UTC calendar month) spending cap for all priced LLM use (agent trials and
# OpenAI judge calls), in USD; 0 disables it.
LLM_BUDGET_USD=50
LLM_MAX_ITERS=30

# Judge calls (Sufficiency, Code Smell, Review Report) use LLM_PROVIDER/LLM_MODEL. For the real
# OpenAI API these two apply (the output cap includes reasoning tokens). Ignored otherwise.
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=16000

# How much of a task's files the Sufficiency / Code Smell judges read (characters). Long documents
# are cut at the per-file limit (the file is still listed as cut), so raise these for tasks with
# big dossiers; defaults are 150000 per file and 500000 in total.
# JUDGE_MAX_FILE_CHARS=150000
# JUDGE_MAX_TOTAL_CHARS=500000
